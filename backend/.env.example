# Copy this file to .env and fill in your key. Never put a real key in this file: it is committed to git.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional overrides
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# TOP_K=4
# USE_RERANKER=true
# CANDIDATE_K=30
# ACCEPT_RERANK=0.01
# BLOCK_DISTANCE=1.6
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# VERIFY_SSL=false
# CORS_ORIGINS=http://localhost:5173
